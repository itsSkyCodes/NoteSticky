{
  "manifest_version": 3,
  "name": "NoteSticky - Webpage & Dashboard Sticky Notes",
  "version": "1.0.0",
  "description": "Create, pin, and organize colorful sticky notes on any webpage with quick search, checklists, and local persistence.",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/content.css", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "NoteSticky Dashboard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "new-sticky-note": {
      "suggested_key": {
        "default": "Alt+Shift+N",
        "mac": "MacCtrl+Shift+N"
      },
      "description": "Add a new sticky note on current page"
    },
    "toggle-notes-visibility": {
      "suggested_key": {
        "default": "Alt+Shift+H",
        "mac": "MacCtrl+Shift+H"
      },
      "description": "Show/hide all sticky notes on this page"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
